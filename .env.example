# LLM providers
_APP_ASSISTANT_ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
_APP_ASSISTANT_OPENAI_API_KEY=YOUR_OPENAI_API_KEY  # still used for embeddings

# Observability (optional — disables Langfuse tracing if not set)
_APP_ASSISTANT_LANGFUSE_PUBLIC_KEY=
_APP_ASSISTANT_LANGFUSE_SECRET_KEY=
_APP_ASSISTANT_LANGFUSE_HOST=https://cloud.langfuse.com

# Doc sources
_BUILD_GIT_URL=https://github.com/appwrite/website.git
_BUILD_GIT_BRANCH=main
_BUILD_WEBSITE_URL=https://appwrite.io
_BUILD_WEBSITE_VERSION=cloud
